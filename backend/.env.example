PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medical_appointments
# true fuerza TLS, false lo desactiva. Si se omite, se activa solo para bases remotas.
DATABASE_SSL=
DB_POOL_MAX=10
# En produccion debe tener al menos 32 caracteres.
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
